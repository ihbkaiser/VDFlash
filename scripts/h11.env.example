# Copy this file, edit the paths, then pass it to scripts/run_dflash_h11.sh.
# Use the Phase 2 draft checkpoint and the resolved config/cache from that run.
H11_CHECKPOINT=/data/outputs/qwen25vl-3b-dflash-llava68k/qwen25vl-3b-dflash-llava68k-latest/training_state.pt
H11_DRAFT_CONFIG="$REPO_ROOT/scripts/h11_full_dflash_3b.json"
H11_FEATURE_ROOT=/data/artifacts/qwen25vl_3b_dflash_llava68k/hidden_states
H11_TARGET_MODEL=/models/qwen25-vl-3b
# Cache-only evaluation uses a separate group of LLaVA training features; no
# video or image files are required. Groups do not overlap with each other,
# but the Phase 2 model was trained on both.
H11_EVAL_MODE=cache

# To run on VDC later, uncomment all four lines and provide real video files.
# H11_EVAL_MODE=video
# H11_MANIFEST=/data/VideoDetailCaption/test.jsonl
# H11_VIDEO_ROOT=/data/VideoDetailCaption
# H11_CALIBRATION=/data/VideoDetailCaption/calibration.jsonl

# Defaults are a small plumbing pilot. Raise H11_LIMIT for a larger cache test.
H11_REFERENCE_SAMPLES=200
H11_LIMIT=2
H11_TRAIN_MAX_LENGTH=3072
H11_MAX_NEW_TOKENS=32
H11_TARGET_VISUAL_TOKENS=3000

# Defaults assume the repo's two-GPU model-parallel profile.
H11_DEVICE=cuda:0
H11_DRAFT_DEVICE=cuda:1
H11_DEVICE_MAP=model_parallel
H11_MAX_MEMORY=0:22GiB,1:14GiB

# Optional. If omitted, every run gets a new UTC-stamped results directory.
# H11_OUTPUT_DIR=/data/results/h11_pilot
