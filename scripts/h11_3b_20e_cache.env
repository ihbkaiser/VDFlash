# H1.1 cache-only profile for the supplied 3B/20e Phase 2 run.
# REPO_ROOT is set by scripts/run_dflash_h11.sh before sourcing this file.
H11_CHECKPOINT=/workspace/storage-shared/nlp/tungdd11/tungdecoder/older_version/VDFlash-main-end-of-dflash/src/train_Dflash_SpecForge/outputs/3b_20e/qwen25vl-3b-dflash-llava68k/qwen25vl-3b-dflash-llava68k-latest/training_state.pt
H11_DRAFT_CONFIG="$REPO_ROOT/scripts/h11_full_dflash_3b.json"
H11_FEATURE_ROOT=/workspace/storage-shared/nlp/tungdd11/tungdecoder/older_version/VDFlash-main-end-of-dflash/src/train_Dflash_SpecForge/artifacts/qwen25vl_dflash_llava68k_3b/hidden_states
H11_TARGET_MODEL=/workspace/storage-shared/nlp/tungdd11/tungdecoder/models/qwen25-vl-3b

H11_EVAL_MODE=cache
# Larger paired run for H1.1 analysis; the original 200/2 setting was a smoke test.
H11_REFERENCE_SAMPLES=1000
H11_LIMIT=200
H11_TRAIN_MAX_LENGTH=3072

# Two GPUs: target model on cuda:0, DFlash draft on cuda:1.
H11_DEVICE=cuda:0
H11_DRAFT_DEVICE=cuda:1
H11_DEVICE_MAP=cuda

# If `python3` is not the training environment, set its interpreter here.
# PYTHON_BIN=/absolute/path/to/.venv/bin/python
