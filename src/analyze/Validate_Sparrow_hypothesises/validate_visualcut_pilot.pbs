#!/bin/bash
#PBS -P hn98
#PBS -q normalbw
#PBS -N vcut-pilot-check
#PBS -r y
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/hn98
#PBS -l wd

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-${PWD}}"
if [[ ! -f "${REPO_ROOT}/requirements.txt" ]]; then
  echo "REPO_ROOT must point to the VDFlash repository root" >&2
  exit 2
fi
RUN_DIR="${RUN_DIR:?RUN_DIR is required}"

cd "${REPO_ROOT}"
export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/src/train_Dflash_SpecForge${PYTHONPATH:+:${PYTHONPATH}}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

"${REPO_ROOT}/.venv/bin/python" -u -m src.analyze.Validate_Sparrow_hypothesises.validate_dflash_visualcut_pilot \
  --run-dir "${RUN_DIR}"
