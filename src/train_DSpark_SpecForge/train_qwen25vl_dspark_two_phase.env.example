# Copy this file and set the server paths. This launcher reads existing caches
# only; it does not prepare data, capture teacher states, or write to DFlash.

TARGET_MODEL_PATH="/path/to/Qwen2.5-VL-3B-Instruct"

# The default roots follow the current DFlash 3-layer cache layout:
# Use these roots only if each record also has target_last_hidden_states. The
# stock DFlash capture layout does not write that DSpark supervision tensor.
#   <SPECFORGE_DFLASH_ARTIFACT_ROOT>/dflash_3layer_<target IDs>/phase1/qwen25vl_3b/hidden_states
#   <SPECFORGE_DFLASH_ARTIFACT_ROOT>/dflash_3layer_<target IDs>/phase2/hidden_states
# Set the DFlash artifact parent if those caches live outside this checkout.
SPECFORGE_DFLASH_ARTIFACT_ROOT="/path/to/existing/dflash/artifacts"
# Or set the two feature roots directly when cache layout differs:
# SPECFORGE_PHASE1_FEATURE_ROOT="/path/to/sharegpt/hidden_states"
# SPECFORGE_PHASE2_FEATURE_ROOT="/path/to/llava/hidden_states"

# DSpark output, resolved configs, and trainer metadata are kept separately.
SPECFORGE_OUTPUT_ROOT="/path/to/dspark/outputs"
SPECFORGE_ARTIFACT_ROOT="/path/to/dspark/artifacts"

# Select one named target set; each must match its existing cache.
SPECFORGE_LAYER_SET=high_only
# SPECFORGE_LAYER_SET=middle_high
# SPECFORGE_LAYER_SET=middle_high_2
# SPECFORGE_LAYER_SET=shallow_high

SPECFORGE_GPU_IDS=0,1
SPECFORGE_GPUS=2
SPECFORGE_NUM_SAMPLES=68000
SPECFORGE_GLOBAL_BATCH_SIZE=64
SPECFORGE_MICRO_BATCH_SIZE=1
SPECFORGE_NUM_EPOCHS=6
SPECFORGE_PHASE1_MAX_LENGTH=2048
SPECFORGE_PHASE2_MAX_LENGTH=3072

# DSpark defaults follow the local/official DSpark config: five draft layers,
# block size 7, Markov rank 256, and CE/L1/confidence weights 0.1/0.9/1.0.
# SPECFORGE_DSPARK_DEPTH=5
# SPECFORGE_DSPARK_BLOCK_SIZE=7
# SPECFORGE_DSPARK_CE_LOSS_ALPHA=0.1
# SPECFORGE_DSPARK_L1_LOSS_ALPHA=0.9
# SPECFORGE_DSPARK_CONFIDENCE_HEAD_ALPHA=1.0
# SPECFORGE_LOSS_DECAY_GAMMA=4.0

# Cache preflight checks sample count and 32 evenly spaced cache files. Use 0 to
# scan every file if a full validation pass is desired.
# SPECFORGE_CACHE_VALIDATE_SAMPLE_LIMIT=32

# Phase 2 only: override the default Phase 1 latest checkpoint when required.
# PHASE1_CHECKPOINT="/path/to/dspark/outputs/.../qwen25vl-3b-dspark-sharegpt68k-...-latest"
