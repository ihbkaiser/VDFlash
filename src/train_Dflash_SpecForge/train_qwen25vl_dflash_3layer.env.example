# Copy this to a private env file and replace the paths with paths on the
# Linux training machine. This is trusted shell syntax, sourced by the launcher.

# Required: Phase 1 ShareGPT source, matching Qwen2.5-VL-3B target model,
# Phase 2 LLaVA JSONL, and either IMAGE_ROOT or IMAGE_ARCHIVE.
SOURCE_DATA="/path/to/ShareGPT_V3_unfiltered_cleaned_split.json"
MODEL_3B="/path/to/Qwen2.5-VL-3B"
SOURCE_JSONL="/path/to/llava_dflash_68k_clean_3b.jsonl"
IMAGE_ARCHIVE="/path/to/llava_images.zip"
# Use IMAGE_ROOT instead of IMAGE_ARCHIVE when the image tree is already extracted.
# IMAGE_ROOT="/path/to/llava/images"

# Optional parent directories. The launcher adds a layer-specific directory,
# then phase1/phase2 subdirectories, so separate layer sets stay isolated.
ARTIFACT_ROOT="/path/to/artifacts"
OUTPUT_ROOT="/path/to/outputs"

# This launcher is fixed to the 3B target and DFlash depth 3.
SPECFORGE_MODEL_SIZE=3b

# Optional training overrides. Defaults match the current two-GPU recipe.
# SPECFORGE_NUM_SAMPLES=68000
# SPECFORGE_GLOBAL_BATCH_SIZE=64
# SPECFORGE_MICRO_BATCH_SIZE=16
# SPECFORGE_NUM_EPOCHS=6
# SPECFORGE_DATALOADER_WORKERS=12
# SPECFORGE_FSDP_SHARDING=NO_SHARD
# SPECFORGE_OBJECTIVE_CHUNK_BLOCKS=256
# SPECFORGE_OPTIMIZER_CPU_OFFLOAD=0
# SPECFORGE_ATTENTION_BACKEND=flex_attention
# SPECFORGE_USE_LIGER=auto
# SPECFORGE_SAVE_INTERVAL=1000
# SPECFORGE_LOG_INTERVAL=100
# SPECFORGE_COMPRESS=0
# SPECFORGE_CAPTURE_BATCH_SIZE=16
# SPECFORGE_CAPTURE_PREPROCESS_WORKERS=8
# SPECFORGE_CAPTURE_PREPROCESS_QUEUE=32
# SPECFORGE_CAPTURE_WORKERS=8
# SPECFORGE_CAPTURE_IO_THREADS=8
# SPECFORGE_CAPTURE_IO_QUEUE=64
# SPECFORGE_SGLANG_MEM_FRACTION_STATIC=0.4
# SPECFORGE_PHASE1_MAX_LENGTH=2048
# SPECFORGE_PHASE2_MAX_LENGTH=3072
# SKIP_PREFLIGHT=1

# Only for a Phase 2-only run, set this to the Phase 1 checkpoint for the same
# layer set. Leave unset when running the default full Phase 1 -> Phase 2 run.
# PHASE1_CHECKPOINT="/path/to/outputs/dflash_3layer_26_28_30_32_34/phase1/qwen25vl-3b-dflash-sharegpt68k-dflash_3layer_26_28_30_32_34/qwen25vl-3b-dflash-sharegpt68k-dflash_3layer_26_28_30_32_34-latest"
