# Copy this file to a private .env file and update the paths.
# The launcher sources this file; use shell quoting for paths containing spaces.

SOURCE_JSONL=/data/llava_dflash_68k_clean_3b.jsonl
TARGET_MODEL_PATH=/models/qwen25-vl-3b
PHASE1_CHECKPOINT=/runs/qwen25vl-phase1/dflash-step10000

# Set exactly one of IMAGE_ROOT or IMAGE_ARCHIVE.
IMAGE_ARCHIVE=/data/images.zip
# IMAGE_ROOT=/data/llava/images

ARTIFACT_ROOT=/data/artifacts/qwen25vl_dflash_llava68k
OUTPUT_ROOT=/data/outputs

# Optional override. run.sh normally discovers this from PYTHON_BIN.
# SPECFORGE_NVRTC_ROOT=/path/to/site-packages/nvidia/cu13

# Set 7b only together with the 7B target/checkpoint and a separate artifact root.
SPECFORGE_MODEL_SIZE=3b
SPECFORGE_GPUS=2
SPECFORGE_NUM_SAMPLES=68000
SPECFORGE_MAX_LENGTH=3072
SPECFORGE_GLOBAL_BATCH_SIZE=64
SPECFORGE_MICRO_BATCH_SIZE=16
SPECFORGE_NUM_EPOCHS=6
SPECFORGE_DATALOADER_WORKERS=12
SPECFORGE_FSDP_SHARDING=NO_SHARD
SPECFORGE_OBJECTIVE_CHUNK_BLOCKS=256
SPECFORGE_OPTIMIZER_CPU_OFFLOAD=0
SPECFORGE_ATTENTION_BACKEND=flex_attention
SPECFORGE_USE_LIGER=auto
SPECFORGE_SAVE_INTERVAL=1000
SPECFORGE_LOG_INTERVAL=100
SPECFORGE_COMPRESS=0
SKIP_PREFLIGHT=1
SPECFORGE_SGLANG_MEM_FRACTION_STATIC=0.4
SPECFORGE_CAPTURE_BATCH_SIZE=16
SPECFORGE_CAPTURE_PREPROCESS_WORKERS=8
SPECFORGE_CAPTURE_PREPROCESS_QUEUE=32
SPECFORGE_CAPTURE_IO_THREADS=8
SPECFORGE_CAPTURE_IO_QUEUE=64
