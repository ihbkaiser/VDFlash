# Copy this file to a private .env file and update the paths.
# The launcher sources this file; use shell quoting for paths containing spaces.

SOURCE_JSONL=/data/llava_dflash_68k_clean_3b.jsonl
TARGET_MODEL_PATH=/models/qwen25-vl-3b
PHASE1_CHECKPOINT=/runs/qwen25vl-phase1/dflash-step10000

# Set exactly one of IMAGE_ROOT or IMAGE_ARCHIVE.
IMAGE_ARCHIVE=/data/images.zip
# IMAGE_ROOT=/data/llava/images

ARTIFACT_ROOT=/data/artifacts/qwen25vl_dflash_llava68k
OUTPUT_ROOT=/data/outputs

SPECFORGE_GPUS=4
SPECFORGE_NUM_SAMPLES=68000
SPECFORGE_MAX_LENGTH=3072
SPECFORGE_GLOBAL_BATCH_SIZE=64
SPECFORGE_MICRO_BATCH_SIZE=1
SPECFORGE_COMPRESS=0
